# Copie este archivo como ".env" y ajuste los valores. El archivo ".env" NO se sube a git.
DATABASE_URL=postgres://USUARIO:CLAVE@localhost:5432/caja
PORT=3000
# Solo esta computadora: 127.0.0.1. Para abrirlo a otros equipos de la red: 0.0.0.0
HOST=127.0.0.1
# Zona horaria del negocio (define qué es "hoy", "ayer" y "antier")
TZ_NEGOCIO=America/Bogota
# 1 si la base está en un servicio en la nube que exige conexión cifrada (por ejemplo Supabase)
# PGSSL=1

# ---- Copia en la nube (opcional): para ver stock y ventas desde otro sitio ----
# Supabase: Connect > "Session pooler" (funciona en redes sin IPv6). Neon: cadena de conexión del proyecto.
# CLOUD_DATABASE_URL=postgres://USUARIO:CLAVE@HOST:5432/postgres
# Supabase: descargue el certificado en Database Settings > SSL Configuration y ponga aquí su ruta
# CLOUD_SSL_CA=C:\Caja\supabase-ca.crt
# Cada cuántos segundos intenta subir los cambios (por defecto 30)
# SYNC_SECONDS=30
